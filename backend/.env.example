# WebSentinel — email alert settings example
# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.

# Gmail address that sends the alert (e.g. you@gmail.com)
ALERT_EMAIL_FROM=@gmail.com

# Gmail App Password (16 letters, no spaces). Never commit this file.
ALERT_EMAIL_PASSWORD=

# Recipient address(es); separate multiple addresses with commas
ALERT_EMAIL_TO=owner@example.com

# SMTP server hostname (default: smtp.gmail.com)
ALERT_SMTP_HOST=smtp.gmail.com

# SMTP port: 465 for SSL (default), 587 for STARTTLS, 1025 for local debug
ALERT_SMTP_PORT=465

# Use SSL connection: true (default) or false (local debug server only)
ALERT_SMTP_SSL=true

# Timezone for timestamps in alert emails (default: Asia/Kolkata)
ALERT_TIMEZONE=Asia/Kolkata

# Maximum emails sent per rolling 60-second window (default: 10)
ALERT_MAX_PER_MINUTE=10

# Optional: full URL to your dashboard, added as a link in every email
ALERT_DASHBOARD_URL=
